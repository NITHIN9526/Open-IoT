# Prefer npm run setup; it creates random credentials without overwriting .env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_PORT=5433
DATABASE_URL=postgres://openiot:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5433/openiot_m1
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
APP_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# For ESP32 LAN access: MQTT_HOST=0.0.0.0 (trusted LAN only).
# For phone browser access: APP_ORIGIN=http://YOUR_LAPTOP_LAN_IP:5173
# Optional Docker app profile uses its own browser origin:
# DOCKER_APP_ORIGIN=http://localhost:3000
# HTTPS deployment only: NODE_ENV=production, APP_ORIGIN=https://iot.example.com
# Set TRUST_PROXY=loopback only when a trusted local reverse proxy is used.

# Optional voice-control backend (see docs/VOICE_CONTROL.md).
VOICE_ENABLED=false
# Generate a separate 32-byte base64url value; never reuse a device token.
ALEXA_BRIDGE_SECRET=
